<Application
    x:Class="QuickEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:QuickEditor">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="PreviewBrush" Color="#121212" />
                    <SolidColorBrush x:Key="PreviewMutedBrush" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="TimelineBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TimelineTrackBrush" Color="#DEE3E8" />
                    <SolidColorBrush x:Key="TimelineOutsideBrush" Color="#B8C0C8" />
                    <SolidColorBrush x:Key="TimelineRulerBrush" Color="#65717E" />
                    <SolidColorBrush x:Key="TimelineSelectionBrush" Color="#B9D8F4" />
                    <SolidColorBrush x:Key="TimelineSelectionHighlightBrush" Color="#35FFFFFF" />
                    <SolidColorBrush x:Key="TimelineHandleBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#00324D" />
                    <SolidColorBrush x:Key="CanvasBrush" Color="#202020" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="InkBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#B5B5B5" />
                    <SolidColorBrush x:Key="LineBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="PreviewBrush" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="PreviewMutedBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="TimelineBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="TimelineTrackBrush" Color="#383838" />
                    <SolidColorBrush x:Key="TimelineOutsideBrush" Color="#101010" />
                    <SolidColorBrush x:Key="TimelineRulerBrush" Color="#B8C2CD" />
                    <SolidColorBrush x:Key="TimelineSelectionBrush" Color="#1A5B96" />
                    <SolidColorBrush x:Key="TimelineSelectionHighlightBrush" Color="#35FFFFFF" />
                    <SolidColorBrush x:Key="TimelineHandleBrush" Color="#F5F5F5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="PreviewBrush" Color="#121212" />
                    <SolidColorBrush x:Key="PreviewMutedBrush" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="TimelineBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TimelineTrackBrush" Color="#DEE3E8" />
                    <SolidColorBrush x:Key="TimelineOutsideBrush" Color="#B8C0C8" />
                    <SolidColorBrush x:Key="TimelineRulerBrush" Color="#65717E" />
                    <SolidColorBrush x:Key="TimelineSelectionBrush" Color="#B9D8F4" />
                    <SolidColorBrush x:Key="TimelineSelectionHighlightBrush" Color="#35FFFFFF" />
                    <SolidColorBrush x:Key="TimelineHandleBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>