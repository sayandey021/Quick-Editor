<Window
    x:Class="QuickEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Controls"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="RootLayout" Background="{ThemeResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource PanelBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="Quick Editor" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="FileNameText" Grid.Column="2" Text="No file open" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
            <Button x:Name="ThemeToggleButton" Grid.Column="3" Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="16"
                    UseSystemFocusVisuals="False"
                    Click="ThemeToggleButton_Click"
                    AutomationProperties.Name="Switch theme" ToolTipService.ToolTip="Switch theme"
                    VerticalAlignment="Center" Margin="3,0">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="FocusStrokeColorOuter" Color="Transparent" />
                    <SolidColorBrush x:Key="FocusStrokeColorInner" Color="Transparent" />
                </Button.Resources>
                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="ThemeGlyphRotate" Angle="0" />
                            <ScaleTransform x:Name="ThemeGlyphScale" ScaleX="1" ScaleY="1" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <FontIcon x:Name="ThemeToggleGlyph" Glyph="&#xE708;" FontSize="15"
                              Foreground="{ThemeResource InkBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button x:Name="OpenButton" Grid.Column="4" Content="Open file" Click="OpenButton_Click" Height="32" Padding="12,0" Margin="4,0" VerticalAlignment="Center" />
            <Button x:Name="ExportButton" Grid.Column="5" Content="Export copy" Click="ExportButton_Click" Height="32" Padding="12,0" Margin="4,0" Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}" VerticalAlignment="Center" IsEnabled="False" />

            <!-- Custom Window Caption Buttons matching the app aesthetic -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="6,0,0,0">
                <Rectangle Width="1" Height="18" Fill="{ThemeResource LineBrush}" Margin="2,0,6,0" VerticalAlignment="Center" />

                <!-- Minimize Button -->
                <Button x:Name="MinimizeButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6"
                        UseSystemFocusVisuals="False"
                        Click="MinimizeButton_Click"
                        AutomationProperties.Name="Minimize" ToolTipService.ToolTip="Minimize"
                        VerticalAlignment="Center">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="{ThemeResource InkBrush}" />
                </Button>

                <!-- Maximize / Restore Button -->
                <Button x:Name="MaximizeButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6"
                        UseSystemFocusVisuals="False"
                        Click="MaximizeButton_Click"
                        AutomationProperties.Name="Maximize" ToolTipService.ToolTip="Maximize"
                        VerticalAlignment="Center">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon x:Name="MaximizeGlyph" Glyph="&#xE922;" FontSize="10" Foreground="{ThemeResource InkBrush}" />
                </Button>

                <!-- Close Button -->
                <Button x:Name="CloseButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6"
                        UseSystemFocusVisuals="False"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Close" ToolTipService.ToolTip="Close"
                        VerticalAlignment="Center">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    </Button.Resources>
                    <FontIcon x:Name="CloseGlyph" Glyph="&#xE8BB;" FontSize="10" Foreground="{ThemeResource InkBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="20" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="325" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PreviewSurface" Grid.Row="0" Background="{ThemeResource PreviewBrush}" CornerRadius="8" AllowDrop="True" SizeChanged="PreviewSurface_SizeChanged">
                    <Grid>
                        <media:MediaPlayerElement x:Name="Preview" AutoPlay="False" AreTransportControlsEnabled="False" Stretch="Uniform" />
                        <canvas:CanvasControl x:Name="VideoCanvas" Draw="VideoCanvas_Draw" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Canvas x:Name="OverlayCanvas"
                            Background="Transparent"
                            Visibility="Visible"
                            IsHitTestVisible="True"
                            PointerPressed="OverlayCanvas_PointerPressed"
                            PointerMoved="OverlayCanvas_PointerMoved"
                            PointerReleased="OverlayCanvas_PointerReleased"
                            PointerCanceled="OverlayCanvas_PointerCanceled"
                            PointerCaptureLost="OverlayCanvas_PointerCaptureLost"
                            PointerExited="OverlayCanvas_PointerExited"
                            SizeChanged="OverlayCanvas_SizeChanged" />
                        <Canvas x:Name="CropOverlay"
                            Background="Transparent"
                                Visibility="Collapsed"
                                IsHitTestVisible="True"
                                PointerPressed="CropOverlay_PointerPressed"
                                PointerMoved="CropOverlay_PointerMoved"
                                PointerReleased="CropOverlay_PointerReleased"
                                PointerCanceled="CropOverlay_PointerCanceled"
                                SizeChanged="CropOverlay_SizeChanged" />
                        <Canvas x:Name="AudioWaveformViewport" Background="{ThemeResource CanvasBrush}" Visibility="Collapsed" IsHitTestVisible="False" SizeChanged="AudioWaveformViewport_SizeChanged" />
                        <Border x:Name="EmptyStateSurface" Background="{ThemeResource CanvasBrush}" CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon x:Name="EmptyStateIcon" Glyph="&#xE714;" FontSize="34" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateTitle" Text="Drop a clip here to get started" Foreground="{ThemeResource InkBrush}" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateSubtitle" Visibility="Collapsed" Foreground="{ThemeResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />
                                <Button x:Name="EmptyStateButton" Content="Choose a file" Click="OpenButton_Click" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{ThemeResource PanelBrush}" CornerRadius="8" Padding="12,8">
                    <StackPanel Spacing="6">
                        <Grid Height="36" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TRIM &amp; CUT" FontSize="10" FontWeight="SemiBold" CharacterSpacing="1" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Button x:Name="PlaybackButton" Grid.Column="1" Width="36" Height="32" Padding="0" Click="PlaybackButton_Click" IsEnabled="False" AutomationProperties.Name="Play" ToolTipService.ToolTip="Play / Pause (Space)" Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}" BorderThickness="0" CornerRadius="6" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                <FontIcon x:Name="PlaybackGlyph" Glyph="&#xE768;" FontSize="13" />
                            </Button>
                            <Button x:Name="NewCutButton" Grid.Column="2" Click="NewCutButton_Click" IsEnabled="False" Height="32" Padding="8,0" Background="{ThemeResource PanelBrush}" Foreground="{ThemeResource InkBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="New cut" ToolTipService.ToolTip="New cut at playhead (Split)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C0;" FontSize="12" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="New cut" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteCutButton" Grid.Column="3" Click="DeleteCutButton_Click" IsEnabled="False" Visibility="Collapsed" Height="32" Padding="8,0" Background="{ThemeResource PanelBrush}" Foreground="{ThemeResource InkBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Delete cut" ToolTipService.ToolTip="Remove selected cut">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource TimelinePlayheadBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Delete cut" FontSize="11.5" Foreground="{ThemeResource TimelinePlayheadBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PreviewTrimButton" Grid.Column="4" Content="Preview edits" Click="PreviewTrimButton_Click" IsEnabled="False" Height="32" Padding="8,0" FontSize="11.5" Background="{ThemeResource PanelBrush}" Foreground="{ThemeResource InkBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" VerticalContentAlignment="Center" />

                            <!-- Volume Pill (Left Group) -->
                            <Border Grid.Column="5" Height="32" Padding="6,0,8,0" Background="{ThemeResource CanvasBrush}" CornerRadius="6" VerticalAlignment="Center" PointerWheelChanged="VolumeControl_PointerWheelChanged">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="VolumeMuteButton" Width="26" Height="26" Padding="0" Click="VolumeMuteButton_Click" AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute / Unmute" Background="Transparent" BorderThickness="0" CornerRadius="4" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                        <FontIcon x:Name="VolumeGlyph" Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Width="82" Height="32" MinHeight="0" Padding="10,0,10,0" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01" IsThumbToolTipEnabled="False" AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume (scroll to adjust)" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" Margin="0,-3,0,0" />
                                    <TextBlock x:Name="VolumePercentText" Text="100%" MinWidth="28" FontSize="10.5" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,-1,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Flexible spacer (Column 6) pushes timeline zoom & duration to the right -->

                            <!-- Timeline Zoom Pill (Right Group, near Timestamp) -->
                            <Border Grid.Column="7" Height="32" Padding="4,0,6,0" Background="{ThemeResource CanvasBrush}" CornerRadius="6" VerticalAlignment="Center" PointerWheelChanged="TimelineZoomControl_PointerWheelChanged">
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button x:Name="TimelineZoomOutButton" Width="24" Height="26" Padding="0" AutomationProperties.Name="Zoom out timeline" ToolTipService.ToolTip="Zoom out (Ctrl + Mouse wheel down)" Background="Transparent" BorderThickness="0" CornerRadius="4" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="False">
                                        <FontIcon Glyph="&#xE71F;" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                    <Slider x:Name="TimelineZoomSlider" Width="76" Height="32" MinHeight="0" Padding="10,0,10,0" Minimum="1" Maximum="10" Value="1" StepFrequency="0.25" IsThumbToolTipEnabled="False" AutomationProperties.Name="Timeline zoom" ToolTipService.ToolTip="Timeline zoom (scroll to adjust)" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" Margin="0,-3,0,0" IsEnabled="False" />
                                    <Button x:Name="TimelineZoomInButton" Width="24" Height="26" Padding="0" AutomationProperties.Name="Zoom in timeline" ToolTipService.ToolTip="Zoom in (Ctrl + Mouse wheel up)" Background="Transparent" BorderThickness="0" CornerRadius="4" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="False">
                                        <FontIcon Glyph="&#xE71E;" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="TimelineZoomResetButton" Height="24" Padding="4,0" AutomationProperties.Name="Reset timeline zoom" ToolTipService.ToolTip="Reset zoom (100% / Fit)" Background="Transparent" BorderThickness="0" CornerRadius="4" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="False">
                                        <TextBlock x:Name="TimelineZoomPercentText" Text="100%" MinWidth="26" FontSize="10.5" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="DurationText" Grid.Column="8" Text="00:00.0 selected / 00:00.0" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border Background="{ThemeResource TimelineBrush}" CornerRadius="8">
                            <ScrollViewer x:Name="TimelineScrollViewer"
                                Height="76"
                                CornerRadius="8"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollMode="Disabled">
                                <Canvas x:Name="TimelineCanvas"
                                    Height="76"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    PointerPressed="TimelineCanvas_PointerPressed"
                                    PointerMoved="TimelineCanvas_PointerMoved"
                                    PointerReleased="TimelineCanvas_PointerReleased"
                                    PointerCanceled="TimelineCanvas_PointerCanceled"
                                    SizeChanged="TimelineCanvas_SizeChanged" />
                            </ScrollViewer>
                        </Border>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartTimeText" Text="Start  00:00.0" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                            <TextBlock x:Name="PlayheadTimeText" Grid.Column="1" Text="Playhead  00:00.0" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                            <TextBlock x:Name="EndTimeText" Grid.Column="2" Text="End  00:00.0" FontSize="12" Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{ThemeResource PanelBrush}" CornerRadius="8" Padding="18">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="3">
                        <TextBlock Text="Adjust" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                        <TextBlock Text="Simple edits, ready to export." FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Your clip" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                        <TextBlock x:Name="MetadataText" Text="Open a video or audio file to see its details." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>

                    <!-- Mode Tabs: Video, Audio, Overlays -->
                    <Grid x:Name="AdjustmentTabsGrid" ColumnSpacing="4" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VideoTabButton" Content="Video" Click="VideoTabButton_Click" HorizontalAlignment="Stretch" Padding="2,5" FontSize="12" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="AudioTabButton" Grid.Column="1" Click="AudioTabButton_Click" HorizontalAlignment="Stretch" Padding="2,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="Audio" FontSize="12" VerticalAlignment="Center" />
                                <Ellipse x:Name="AudioActiveBadge" Width="6" Height="6" Fill="{ThemeResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OverlaysTabButton" Grid.Column="2" Click="OverlaysTabButton_Click" HorizontalAlignment="Stretch" Padding="2,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock x:Name="OverlaysTabLabel" Text="Overlays" FontSize="12" VerticalAlignment="Center" />
                                <Border x:Name="OverlaysCountBadge" Background="{ThemeResource AccentBrush}" CornerRadius="7" MinWidth="16" Height="16" Padding="4,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="OverlaysCountText" Text="0" FontSize="9.5" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Video Adjustments: Permanent section without expander/dropdown -->
                    <StackPanel x:Name="VideoAdjustments" Spacing="12" Visibility="Collapsed">
                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Crop" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <Button x:Name="CropModeButton" Content="Crop video" Click="CropModeButton_Click" Height="28" Padding="12,0" />
                                    <Button x:Name="ResetCropButton" Content="Reset" Click="ResetCropButton_Click" Visibility="Collapsed" Height="28" Padding="10,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Horizontal scrolling side-by-side ratio row with aspect diagrams -->
                            <ScrollViewer x:Name="CropRatiosScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled"
                                          PointerWheelChanged="CropRatiosScrollViewer_PointerWheelChanged">
                                <StackPanel x:Name="CropRatiosPanel" Orientation="Horizontal" Spacing="6" Padding="1,2,1,2">
                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="free" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="Freeform crop">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="20" Height="20" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" StrokeDashArray="2,2" RadiusX="3" RadiusY="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="Free" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="1.7777778" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="16:9 Landscape (YouTube, TV)">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="25" Height="14" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="16:9" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="0.5625" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="9:16 Vertical (Shorts, Reels, TikTok)">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="14" Height="25" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="9:16" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="1" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="1:1 Square (Instagram)">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="20" Height="20" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="1:1" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="0.8" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="4:5 Portrait (Instagram)">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="16" Height="20" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="4:5" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="1.25" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="5:4 Large format">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="20" Height="16" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="5:4" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="1.3333333" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="4:3 Standard TV">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="22" Height="16.5" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="4:3" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="0.75" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="3:4 Portrait SD">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="16.5" Height="22" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="3:4" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="2.3333333" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="21:9 Ultrawide / CinemaScope">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="11" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="21:9" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="2" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="2:1 Univisium">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="24" Height="12" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="2:1" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="1.5" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="3:2 Classic 35mm">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="22" Height="14.5" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="3:2" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Tag="0.6666667" Click="CropRatioButton_Click" Width="58" Height="62" Padding="4,6,4,4" CornerRadius="8" ToolTipService.ToolTip="2:3 Portrait 35mm">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <Grid Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="14.5" Height="22" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="2:3" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource InkBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock x:Name="CropHintText" Text="Choose a ratio, then drag over the video." FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                        <!-- White Balance (Lightroom style) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="White Balance" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                            
                            <!-- Temperature (Cool - Warm) -->
                            <Grid>
                                <TextBlock Text="Temperature" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="TemperatureValueText" Text="0" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="TemperatureSlider" Minimum="-100" Maximum="100" Value="0" StepFrequency="1" ValueChanged="VideoAdjustment_ValueChanged" Foreground="#FF9800" />

                            <!-- Tint (Green - Magenta) -->
                            <Grid>
                                <TextBlock Text="Tint" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="TintValueText" Text="0" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="TintSlider" Minimum="-100" Maximum="100" Value="0" StepFrequency="1" ValueChanged="VideoAdjustment_ValueChanged" Foreground="#E91E63" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                        <!-- Tone (Lightroom style) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Tone" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />

                            <!-- Exposure / Brightness -->
                            <Grid>
                                <TextBlock Text="Exposure" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="BrightnessValueText" Text="0.00" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="BrightnessSlider" Minimum="-0.5" Maximum="0.5" Value="0" StepFrequency="0.02" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <!-- Contrast -->
                            <Grid>
                                <TextBlock Text="Contrast" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="ContrastValueText" Text="0.00" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ContrastSlider" Minimum="-1" Maximum="1" Value="0" StepFrequency="0.05" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <!-- Highlights -->
                            <Grid>
                                <TextBlock Text="Highlights" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="HighlightsValueText" Text="0.00" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="HighlightsSlider" Minimum="-1" Maximum="1" Value="0" StepFrequency="0.05" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <!-- Shadows -->
                            <Grid>
                                <TextBlock Text="Shadows" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="ShadowsValueText" Text="0.00" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ShadowsSlider" Minimum="-1" Maximum="1" Value="0" StepFrequency="0.05" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                        <!-- Presence / Color (Lightroom style) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Presence" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />

                            <!-- Vibrance -->
                            <Grid>
                                <TextBlock Text="Vibrance" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="VibranceValueText" Text="0.00" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="VibranceSlider" Minimum="-1" Maximum="1" Value="0" StepFrequency="0.05" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <!-- Saturation -->
                            <Grid>
                                <TextBlock Text="Saturation" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="SaturationValueText" Text="1.00" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SaturationSlider" Minimum="0" Maximum="2" Value="1" StepFrequency="0.05" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <!-- Hue -->
                            <Grid>
                                <TextBlock Text="Hue" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="HueValueText" Text="0°" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="HueSlider" Minimum="-180" Maximum="180" Value="0" StepFrequency="2" ValueChanged="VideoAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Button Content="Reset video" Click="ResetVideoAdjustments_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="AudioAdjustments" Spacing="10" Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="Audio adjustments" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                            <TextBlock x:Name="AudioStatusBadge" Text="Live DSP Active" FontSize="11" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Right" Visibility="Collapsed" VerticalAlignment="Center" />
                        </Grid>
                        
                        <!-- Pitch & Speed -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="Pitch &amp; Speed" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" />
                            <Grid>
                                <TextBlock Text="Pitch" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="PitchValueText" Text="0 semitones" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                            
                            <Grid>
                                <TextBlock Text="Playback speed" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="SpeedValueText" Text="1.00x" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2" Value="1" StepFrequency="0.05" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                        <!-- Volume Boost & Normalization -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="Volume Boost &amp; Normalize" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" />
                            <Grid>
                                <TextBlock Text="Volume boost" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="VolumeBoostValueText" Text="100%" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="VolumeBoostSlider" Minimum="100" Maximum="300" Value="100" StepFrequency="5" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                            
                            <CheckBox x:Name="NormalizeCheckBox" MinHeight="0" Padding="8,0,0,0" VerticalContentAlignment="Center" Checked="AudioAdjustment_CheckChanged" Unchecked="AudioAdjustment_CheckChanged">
                                <TextBlock Text="Normalize audio" FontSize="12" VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </CheckBox>
                            <Button x:Name="AutoNormalizeButton" Content="Auto-calibrate peak" Click="AutoNormalizeButton_Click" HorizontalAlignment="Left" FontSize="11" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                        <!-- 6-Band Equalizer -->
                        <StackPanel Spacing="7">
                            <Grid>
                                <TextBlock Text="6-Band Equalizer" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" />
                                <Button Content="Reset EQ" Click="ResetEq_Click" HorizontalAlignment="Right" FontSize="11" Padding="6,2" />
                            </Grid>
                            <ComboBox x:Name="EqPresetComboBox" SelectionChanged="EqPresetComboBox_SelectionChanged" HorizontalAlignment="Stretch" FontSize="12">
                                <ComboBoxItem Content="Flat" IsSelected="True" />
                                <ComboBoxItem Content="Bass Boost" />
                                <ComboBoxItem Content="Vocal Enhance" />
                                <ComboBoxItem Content="Treble Boost" />
                                <ComboBoxItem Content="Loudness" />
                                <ComboBoxItem Content="Acoustic" />
                            </ComboBox>
                            
                            <Grid>
                                <TextBlock Text="80 Hz (Sub)" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="EqBand1Text" Text="0 dB" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="EqBand1Slider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Grid>
                                <TextBlock Text="240 Hz (Bass)" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="EqBand2Text" Text="0 dB" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="EqBand2Slider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Grid>
                                <TextBlock Text="750 Hz (Low Mid)" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="EqBand3Text" Text="0 dB" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="EqBand3Slider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Grid>
                                <TextBlock Text="2.2 kHz (High Mid)" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="EqBand4Text" Text="0 dB" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="EqBand4Slider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Grid>
                                <TextBlock Text="6 kHz (Treble)" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="EqBand5Text" Text="0 dB" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="EqBand5Slider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Grid>
                                <TextBlock Text="12 kHz (Air)" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="EqBand6Text" Text="0 dB" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="EqBand6Slider" Minimum="-12" Maximum="12" Value="0" StepFrequency="1" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />

                        <!-- Reverb -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="Reverb" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" />
                            <Grid>
                                <TextBlock Text="Reverb mix" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="ReverbMixValueText" Text="0% (Dry)" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ReverbMixSlider" Minimum="0" Maximum="100" Value="0" StepFrequency="2" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <Grid>
                                <TextBlock Text="Room size" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="ReverbRoomValueText" Text="50%" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ReverbRoomSlider" Minimum="10" Maximum="100" Value="50" StepFrequency="5" ValueChanged="AudioAdjustment_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                        </StackPanel>

                        <Button Content="Reset all audio" Click="ResetAudioAdjustments_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Overlays Panel (Text & Image) -->
                    <StackPanel x:Name="OverlaysPanel" Spacing="14" Visibility="Collapsed">
                        <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Text &amp; Image Overlays" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                            <TextBlock Text="Add custom text captions, watermarks, or images over your video." FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AddTextOverlayButton" Click="AddTextOverlayButton_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                                        <TextBlock Text="Add text" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AddImageOverlayButton" Grid.Column="1" Click="AddImageOverlayButton_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                                        <TextBlock Text="Add image" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Layers List -->
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="NoOverlaysHint" Text="No overlays added yet. Click above to add text or an image." FontSize="11" Foreground="{ThemeResource MutedBrush}" FontStyle="Italic" Margin="0,2" />
                            <StackPanel x:Name="OverlaysListPanel" Spacing="4" />
                        </StackPanel>

                        <!-- Selected Overlay Inspector -->
                        <StackPanel x:Name="SelectedOverlayInspector" Spacing="12" Visibility="Collapsed">
                            <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />
                            <Grid>
                                <TextBlock x:Name="InspectorTitleText" Text="Edit Text Overlay" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                <Button x:Name="DeleteOverlayButton" Click="DeleteOverlayButton_Click" Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" ToolTipService.ToolTip="Delete this overlay">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF3B30" />
                                </Button>
                            </Grid>

                            <!-- TEXT SETTINGS -->
                            <StackPanel x:Name="TextSettingsPanel" Spacing="8">
                                <TextBox x:Name="OverlayTextBox" Header="Text content" PlaceholderText="Enter caption..." TextChanged="OverlayText_TextChanged" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="72" />
                                
                                <Grid>
                                    <TextBlock Text="Font size" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                    <TextBlock x:Name="OverlayFontSizeText" Text="32 pt" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="OverlayFontSizeSlider" Minimum="14" Maximum="96" Value="32" StepFrequency="2" ValueChanged="OverlayFontSizeSlider_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                                <TextBlock Text="Text color" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <StackPanel x:Name="TextColorPalette" Orientation="Horizontal" Spacing="8" Margin="0,2,0,4" />

                                <CheckBox x:Name="OverlayHasBgCheckBox" MinHeight="0" Padding="8,0,0,0" VerticalContentAlignment="Center" Checked="OverlayBg_Changed" Unchecked="OverlayBg_Changed">
                                    <TextBlock Text="Background banner box" FontSize="12" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </CheckBox>
                                <StackPanel x:Name="OverlayBgOpacityGroup" Spacing="4" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock Text="Box opacity" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="OverlayBgOpacityText" Text="60%" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="OverlayBgOpacitySlider" Minimum="10" Maximum="100" Value="60" StepFrequency="5" ValueChanged="OverlayBgOpacitySlider_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- IMAGE SETTINGS -->
                            <StackPanel x:Name="ImageSettingsPanel" Spacing="8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChangeImageButton" Content="Change image..." Click="ChangeImageButton_Click" />
                                    <TextBlock x:Name="ImageFileNameText" Text="image.png" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>

                                <Grid>
                                    <TextBlock Text="Image width" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                    <TextBlock x:Name="OverlayImageSizeText" Text="25%" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="OverlayImageSizeSlider" Minimum="5" Maximum="80" Value="25" StepFrequency="1" ValueChanged="OverlayImageSizeSlider_ValueChanged" Foreground="{ThemeResource AccentBrush}" />
                            </StackPanel>

                            <!-- COMMON: Opacity -->
                            <Grid>
                                <TextBlock Text="Overall opacity" FontSize="12" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock x:Name="OverlayOpacityText" Text="100%" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="OverlayOpacitySlider" Minimum="10" Maximum="100" Value="100" StepFrequency="5" ValueChanged="OverlayOpacitySlider_ValueChanged" Foreground="{ThemeResource AccentBrush}" />

                            <!-- POSITION & ALIGNMENT -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Position &amp; Alignment" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" />
                                <TextBlock Text="💡 Drag directly on the video preview, or use presets:" FontSize="10.5" Foreground="{ThemeResource MutedBrush}" />
                                
                                <Grid RowSpacing="4" ColumnSpacing="4" HorizontalAlignment="Center" Margin="0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AlignTL" Grid.Row="0" Grid.Column="0" Content="TL" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="TL" ToolTipService.ToolTip="Top-Left" />
                                    <Button x:Name="AlignTC" Grid.Row="0" Grid.Column="1" Content="TC" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="TC" ToolTipService.ToolTip="Top-Center" />
                                    <Button x:Name="AlignTR" Grid.Row="0" Grid.Column="2" Content="TR" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="TR" ToolTipService.ToolTip="Top-Right" />
                                    <Button x:Name="AlignCL" Grid.Row="1" Grid.Column="0" Content="CL" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="CL" ToolTipService.ToolTip="Center-Left" />
                                    <Button x:Name="AlignCC" Grid.Row="1" Grid.Column="1" Content="C" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="CC" ToolTipService.ToolTip="Center" />
                                    <Button x:Name="AlignCR" Grid.Row="1" Grid.Column="2" Content="CR" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="CR" ToolTipService.ToolTip="Center-Right" />
                                    <Button x:Name="AlignBL" Grid.Row="2" Grid.Column="0" Content="BL" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="BL" ToolTipService.ToolTip="Bottom-Left" />
                                    <Button x:Name="AlignBC" Grid.Row="2" Grid.Column="1" Content="BC" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="BC" ToolTipService.ToolTip="Bottom-Center (Captions)" />
                                    <Button x:Name="AlignBR" Grid.Row="2" Grid.Column="2" Content="BR" FontSize="10" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="AlignButton_Click" Tag="BR" ToolTipService.ToolTip="Bottom-Right (Watermark)" />
                                </Grid>
                            </StackPanel>

                            <!-- TIMING -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Display Timing" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" />
                                <CheckBox x:Name="OverlayEntireVideoCheckBox" MinHeight="0" Padding="8,0,0,0" VerticalContentAlignment="Center" IsChecked="True" Checked="OverlayTiming_Changed" Unchecked="OverlayTiming_Changed">
                                    <TextBlock Text="Show throughout entire video" FontSize="12" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </CheckBox>
                                <StackPanel x:Name="OverlayCustomTimingGroup" Spacing="6" Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Start time" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                                            <TextBox x:Name="OverlayStartTimeBox" Text="00:00.0" TextChanged="OverlayTimeBox_TextChanged" />
                                            <Button Content="At playhead" FontSize="10" Padding="6,2" Click="SetOverlayStartToPlayhead_Click" HorizontalAlignment="Stretch" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="End time" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                                            <TextBox x:Name="OverlayEndTimeBox" Text="00:05.0" TextChanged="OverlayTimeBox_TextChanged" />
                                            <Button Content="At playhead" FontSize="10" Padding="6,2" Click="SetOverlayEndToPlayhead_Click" HorizontalAlignment="Stretch" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{ThemeResource LineBrush}" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Export" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" />
                        <TextBlock Text="A new copy is created. Your original stays untouched." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                        <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Text="Ready when you are" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UndoButton" Click="UndoButton_Click" IsEnabled="False" AutomationProperties.Name="Undo trim &amp; cuts" ToolTipService.ToolTip="Undo trim &amp; cuts">
                            <FontIcon Glyph="&#xE7A7;" />
                        </Button>
                        <Button x:Name="ResetButton" Content="Reset trim &amp; cuts" Click="ResetButton_Click" />
                        <Button x:Name="CancelExportButton" Content="Cancel" Click="CancelExportButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="20,0" Background="{ThemeResource PanelBrush}">
            <TextBlock Text="QUICK EDITOR" FontSize="10" CharacterSpacing="1" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="FooterText" Text="Open a video or audio file to begin" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>